{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:path:default",
    "core:event:default",
    "core:window:default",
    "core:app:default",
    "core:resources:default",
    "core:menu:default",
    "core:window:allow-set-fullscreen",
    "dialog:default",
    "dialog:allow-save",
    "dialog:allow-message",
    "dialog:allow-open",
    "fs:read-dirs",
    "fs:write-files",
    "fs:scope-resource",
    "fs:allow-read-file",
    "fs:allow-mkdir",
    {
      "identifier": "fs:scope",
      "allow": [
        {
          "path": "**"
        }
      ]
    },
    {
      "identifier": "http:default",
      "allow": [{ "url": "https://*" }]
    },
    "http:default",
    "window-state:default"
  ]
}
