{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Livideo",
  "version": "0.2.0",
  "identifier": "dev.oblivius.livideo.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Livideo",
        "label": "main",
        "width": 1000,
        "height": 940,
        "resizable": true,
        "minHeight": 445,
        "minWidth": 480,
        "dragDropEnabled": false,
        "visible": false,
        "backgroundColor": "#121212"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost tauri:; media-src 'self' asset: http://* blob: tauri:; img-src 'self' asset: http://asset.localhost; connect-src ipc: http://ipc.localhost 'self' tauri: blob:;",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "GraphicsAndDesign",
    "shortDescription": "Livideo",
    "resources": [
      "resources/**/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "allowDowngrades": true,
      "certificateThumbprint": null,
      "digestAlgorithm": null,
      "nsis": {
        "installerIcon": "icons/icon.ico"
      },
      "signCommand": null,
      "timestampUrl": null,
      "tsp": false,
      "webviewInstallMode": {
        "silent": true,
        "type": "downloadBootstrapper"
      },
      "wix": null
    }
  }
}